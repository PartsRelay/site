---
import Chat from '../components/Chat.astro'
import Costs from '../components/Costs.astro'
import Counter from '../components/Counter.astro'
import Cover from '../components/Cover.astro'
import Film from '../components/Film.astro'
import Gains from '../components/Gains.astro'
import Price from '../components/Price.astro'
import Questions from '../components/Questions.astro'
import SignIn from '../components/SignIn.astro'
import Steps from '../components/Steps.astro'
import { languages } from '../i18n'
import Page from '../layouts/Page.astro'

export const getStaticPaths = () =>
  languages.map(({ path, main }) => ({ params: { locale: main ? undefined : path } }))
---

<Page>
  <Cover />
  <Steps />
  <Gains />
  <Costs />
  <Price />
  <Counter />
  <Chat />
  <Film />
  <Questions />
  <SignIn />
</Page>
