---
import Layout from '../layouts/Layout.astro';
import { contactLink } from '../site';
---

<Layout
  title="Parts Relay | Parts enquiry software for distributors and repair shops"
  description="Parts Relay finds original and aftermarket car parts from a plate or VIN. Your counter searches on the web, workshops search by WhatsApp, and every search lands in one queue."
  home
  structuredData
>
  <div class="site-home-intro">
    <section class="site-hero" aria-labelledby="site-title">
      <div class="site-traces" aria-hidden="true"></div>
      <div class="site-hero-inner">
        <div class="site-hero-copy">
          <h1 id="site-title">
            Parts enquiry software
            <br />
            for the parts counter.
          </h1>
          <p>
            Find original and aftermarket parts from a registration plate or VIN. Your counter
            searches on the web, workshops search by WhatsApp, and every search lands in one company
            queue.
          </p>
          <div class="site-actions">
            <a class="site-action-primary" href={contactLink}>
              <img src="/assets/symbol.svg" alt="" />
              Talk to our team
            </a>
            <a class="site-action-secondary" href="/about/">
              How Parts Relay works
            </a>
          </div>
          <p class="site-hero-free">
            Not a customer yet?
            <a href="/tools/enquiry-builder/">Write an enquiry for your current supplier</a>
            with the free builder.
          </p>
          <aside class="site-sample" aria-label="What a search does">
            <div class="site-sample-record">
              <span>You enter</span>
              <strong>A plate or VIN</strong>
              <small>and the part you need</small>
            </div>
            <div class="site-sample-question">
              <span>You get back</span>
              <p>
                The vehicle, original part numbers with exploded views, and aftermarket matches.
              </p>
            </div>
          </aside>
        </div>
      </div>
    </section>
    <section class="site-marquee" aria-label="Who uses Parts Relay">
      <p>For parts counters and the service desks that ring them.</p>
    </section>
  </div>
  <div class="home">
    <section class="home-app" aria-labelledby="home-app-title">
      <div class="home-wrap home-app-grid">
        <div class="home-app-intro">
          <h2 id="home-app-title">Start with a plate or VIN</h2>
          <p>
            Choose New search, enter the registration plate or the VIN and the part you need, and
            Parts Relay searches the catalogue. The result stays in the company search queue.
          </p>
          <dl>
            <div>
              <dt>What comes back</dt>
              <dd>
                The vehicle, original parts with their OEM codes and positions, exploded views, and
                aftermarket matches.
              </dd>
            </div>
            <div>
              <dt>From WhatsApp too</dt>
              <dd>
                Workshops whose numbers you add as contacts search by sending a message. Their
                searches join the same queue.
              </dd>
            </div>
            <div>
              <dt>Where plates are searched</dt>
              <dd>
                In the country you set for your company. 33 are available, across Europe and the
                United States.
              </dd>
            </div>
          </dl>
          <a href="/about/" class="home-pill">
            How Parts Relay works <span class="home-arrow" aria-hidden="true"></span>
          </a>
        </div>
        <figure>
          <img
            src="/assets/app-new-search.png"
            width="509"
            height="519"
            loading="lazy"
            alt="The New search panel in Parts Relay: a choice of Plate or VIN, a registration plate field, a Part needed field and search tips."
          />
          <figcaption>The New search panel in the Parts Relay web app.</figcaption>
        </figure>
      </div>
    </section>
    <section class="home-wrap home-solutions" aria-label="Free tools">
      <a class="home-solution" href="/tools/vin-check/">
        <span class="home-tip" aria-hidden="true"></span>
        <svg viewBox="0 0 36 36" fill="none" aria-hidden="true">
          <path d="M10 5H5v6m21-6h5v6M10 31H5v-6m21 6h5v-6" />
          <g class="home-scan-a">
            <path d="M10 13v10m3-8v7" />
          </g>
          <g class="home-scan-b">
            <path d="M17 14v9m3-11v12" />
          </g>
          <g class="home-scan-c">
            <path d="M24 15v7m3-9v10" />
          </g>
        </svg>
        <span class="home-s-title">VIN format check</span>
        <span class="home-copy">
          Check the length and characters of a VIN before you pass it to the counter.
        </span>
      </a>
      <a class="home-solution" href="/tools/parts-diagrams/">
        <span class="home-tip" aria-hidden="true"></span>
        <svg viewBox="0 0 36 36" fill="none" aria-hidden="true">
          <path class="home-layer-top" d="m18 4 13 7-13 7-13-7z" />
          <g class="home-lower">
            <path d="m5 18 13 7 13-7M5 25l13 7 13-7" />
          </g>
        </svg>
        <span class="home-s-title">Parts diagrams</span>
        <span class="home-copy">
          A cartridge can sit inside a housing that has its own part number. Pull up the drawing to
          see how the pieces fit.
        </span>
      </a>
      <a class="home-solution" href="/tools/enquiry-builder/">
        <span class="home-tip" aria-hidden="true"></span>
        <svg viewBox="0 0 36 36" fill="none" aria-hidden="true">
          <path d="M6 5h19a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H13l-7 5v-5H5a2 2 0 0 1-2-2V8a3 3 0 0 1 3-3Z" />
          <path class="home-tail" d="M28 13h3a2 2 0 0 1 2 2v16l-6-4H17" />
          <g class="home-blink">
            <path d="M10 13h2m3 0h2m3 0h2" />
          </g>
        </svg>
        <span class="home-s-title">Parts enquiry builder</span>
        <span class="home-copy">
          Put the part, quantity and vehicle details in one message you can send to your
          distributor.
        </span>
      </a>
    </section>
    <section class="home-metrics" id="workflow" aria-labelledby="home-metric-title">
      <div class="home-wrap">
        <div class="home-stat-content">
          <h2 id="home-metric-title">From repair order to supplier enquiry</h2>
          <p class="home-copy">
            Start with the car in the bay. Give the counter enough detail to identify the component
            and tell you what it can supply.
          </p>
          <dl class="home-counts">
            <div>
              <dt>Identify the vehicle</dt>
              <dd>
                <span class="home-count-value">01</span>
              </dd>
            </div>
            <div>
              <dt>Name the component</dt>
              <dd>
                <span class="home-count-value">02</span>
              </dd>
            </div>
            <div>
              <dt>Specify the quantity</dt>
              <dd>
                <span class="home-count-value">03</span>
              </dd>
            </div>
            <div>
              <dt>Ask for a quote</dt>
              <dd>
                <span class="home-count-value">04</span>
              </dd>
            </div>
          </dl>
        </div>
      </div>
    </section>
    <section class="home-wrap home-features" aria-labelledby="home-feature-title">
      <div class="home-feature-head">
        {/* prettier-ignore */}
        <h2 id="home-feature-title">
          What can change<br class="home-wide-break" />
          which part you order?
        </h2>
        <a class="home-pill" href="/tools/enquiry-builder/">
          Prepare an enquiry <span class="home-arrow" aria-hidden="true"></span>
        </a>
      </div>
      <div class="home-fgrid">
        <a class="home-feature" href="/tools/vin-check/">
          <div class="home-fig" data-home-art="vehicle" aria-hidden="true"></div>
          <h3>The engine</h3>
          <p class="home-copy">
            Two cars with the same model badge can have different engines. Give the counter the
            vehicle details from the repair order.
          </p>
        </a>
        <a class="home-feature" href="/tools/parts-diagrams/">
          <div class="home-fig" data-home-art="filter" aria-hidden="true"></div>
          <h3>The damaged piece</h3>
          <p class="home-copy">
            A cracked mirror can mean broken glass or a damaged housing. Point to the piece the
            technician wants replaced.
          </p>
        </a>
        <a class="home-feature" href="/repair-shops/">
          <div class="home-fig" data-home-art="ticket" aria-hidden="true"></div>
          <h3>The kit contents</h3>
          <p class="home-copy">
            If the right rear latch needs an actuator too, put that on the request. The counter can
            check whether they come together.
          </p>
        </a>
        <a class="home-feature" href="/distributors/">
          <div class="home-fig" data-home-art="relay" aria-hidden="true"></div>
          <h3>The plug on the old unit</h3>
          <p class="home-copy">
            When two electrical parts look alike, the shape of the connector may tell the
            distributor which version the car takes.
          </p>
        </a>
      </div>
    </section>
    <section class="home-desk" aria-labelledby="home-desk-title">
      <div class="home-wrap home-desk-grid">
        <div class="home-desk-intro">
          <h2 id="home-desk-title">What the parts counter sees</h2>
          <p>
            At the distributor, staff can look up a part themselves or pick up a request a workshop
            sent to the company’s WhatsApp number. Searches from the counter and from WhatsApp share
            one queue, which shows who asked, on which channel, and what the catalogue found.
          </p>
          <p>
            Plates are searched in the country set for your company. If the returned vehicle doesn’t
            match the one in the bay, the counter can check the plate or VIN with the shop before
            quoting.
          </p>
          <a href="/distributors/" class="home-pill">
            For distributors <span class="home-arrow" aria-hidden="true"></span>
          </a>
        </div>
        <div class="home-desk-record">
          <h3>In Parts Relay: what comes back from a search</h3>
          <dl>
            <div>
              <dt>Vehicle</dt>
              <dd>
                The catalogue’s vehicle description gives the shop a chance to spot a mismatch. A
                status of Vehicle not found is a reason to check the plate or VIN.
              </dd>
            </div>
            <div>
              <dt>Original equipment</dt>
              <dd>
                Original parts come with their OEM code and position. An exploded view, where the
                catalogue has one, helps tell the complete assembly from a piece inside it.
              </dd>
            </div>
            <div>
              <dt>Aftermarket</dt>
              <dd>
                Some results include another manufacturer’s reference. Check the brand and
                specification before suggesting it as a replacement.
              </dd>
            </div>
            <div>
              <dt>Supplier check</dt>
              <dd>
                Results are identification guidance. Ask the supplier to quote the reference and
                check stock, and confirm fitment and what the kit includes before you order.
              </dd>
            </div>
          </dl>
        </div>
      </div>
    </section>
    <div class="home-divider home-wrap" aria-hidden="true"></div>
    <section id="guides" class="home-guides" aria-labelledby="home-guides-title">
      <div class="home-wrap home-news-head">
        <h2 id="home-guides-title">Parts Relay guides</h2>
        <a class="home-pill home-view" href="/library/">
          View all <span class="home-arrow" aria-hidden="true"></span>
        </a>
      </div>
      <div class="home-slider">
        <button type="button" class="home-scroll home-prev" aria-label="Previous guide" disabled>
          ‹
        </button>
        <div
          class="home-track"
          id="home-story-track"
          tabindex="0"
          role="region"
          aria-label="Guide cards"
        >
          <a class="home-item" href="/tools/vin-check/">
            <div class="home-cover home-cover-dark">
              <span class="home-cover-scan">VIN</span>
            </div>
            <div class="home-itemtext">
              <h3>Before you send a VIN</h3>
              <p>Check what you copied from the vehicle before it goes on the enquiry.</p>
              <small>VIN format check</small>
            </div>
          </a>
          <a class="home-item" href="/tools/parts-diagrams/">
            <div class="home-cover home-cover-plate">
              <img
                src="/assets/brake-pads.svg"
                alt="Exploded brake diagram showing the disc and two pads"
                loading="lazy"
              />
            </div>
            <div class="home-itemtext">
              <h3>Read the brake drawing</h3>
              <p>Find the disc and the pads on either side of it.</p>
              <small>Parts diagrams</small>
            </div>
          </a>
          <a class="home-item" href="/guides/guidebook/">
            <div class="home-cover home-cover-thread">
              <span class="home-cover-id">RFQ</span>
            </div>
            <div class="home-itemtext">
              <h3>Write to your supplier</h3>
              <p>Tell the counter what to price and which details you still need confirmed.</p>
              <small>Enquiry guide</small>
            </div>
          </a>
          <a class="home-item" href="/repair-shops/">
            <div class="home-cover home-cover-photo">
              <img
                src="/assets/workshop.webp"
                alt="Service adviser inspecting a part at the workshop counter"
                loading="lazy"
              />
            </div>
            <div class="home-itemtext">
              <h3>From the service desk</h3>
              <p>Turn a technician’s note into a question the distributor can answer.</p>
              <small>For repair shops</small>
            </div>
          </a>
          <a class="home-item" href="/distributors/">
            <div class="home-cover home-cover-photo">
              <img
                src="/assets/counter.webp"
                alt="A parts specialist and a service adviser inspect a headlamp housing."
                loading="lazy"
              />
            </div>
            <div class="home-itemtext">
              <h3>At the distributor</h3>
              <p>Pick up a colleague’s search and see what the shop is waiting for.</p>
              <small>For distributors</small>
            </div>
          </a>
        </div>
        <button type="button" class="home-scroll home-next" aria-label="Next guide">
          ›
        </button>
      </div>
    </section>
    <div class="home-divider home-wrap" aria-hidden="true"></div>
  </div>
  <section class="base-cta" aria-labelledby="base-cta-title">
    <div class="base-motion" aria-hidden="true"></div>
    <div class="base-bound base-cta-inner">
      <h2 id="base-cta-title">See whether it covers the jobs you get</h2>
      <p>
        Write to contact@reasonandrender.com with two recent enquiries, one you answered easily and
        one that took another phone call, and the country your vehicles are registered in. We can
        check them against catalogue coverage.
      </p>
      <div class="base-actions">
        <a class="base-button base-light" href={contactLink}>
          <img alt="" src="/assets/symbol.svg" />
          Email the Parts Relay team
        </a>
        <a class="base-button base-tint" href="/about/">
          About Parts Relay
        </a>
      </div>
    </div>
  </section>
</Layout>

<script>
  import '../scripts/home.js';
</script>
