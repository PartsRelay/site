---
import Layout from '../../layouts/Layout.astro';
import ClosingBand from '../ClosingBand.astro';
import FigureNotes from '../FigureNotes.astro';
import { partsDiagrams } from '../../i18n/pages/parts-diagrams';
import { localizedPath, ui } from '../../i18n/ui';

interface Props {
  locale: keyof typeof ui;
}

const { locale } = Astro.props;
const t = partsDiagrams[locale];
const link = (href: string) => localizedPath(locale, href);
const images = ['/assets/brake-pads.svg', '/assets/alternator.svg', '/assets/manual.webp'];
const figures = t.figures.map((figure, index) => ({ ...figure, image: images[index] }));
const deckLinks = ['/tools/part-details/', '/guides/vehicle-identification/', '/guides/counter/'];
---

<Layout title={t.title} description={t.description}>
  <div class="tool tool-diagrams">
    <section class="tool-hero">
      <div class="tool-bound">
        <div class="tool-title">
          <p class="tool-label">{t.label}</p>
          <h1 tabindex="-1">{t.heading}</h1>
          <p class="tool-intro">{t.intro}</p>
          <div class="page-actions">
            <button type="button" class="page-btn" data-jump="tool-figures">
              {t.explore}
            </button>
            <a class="page-btn page-secondary" href={link('/tools/vin-check/')}>
              {t.checkVin}
            </a>
          </div>
        </div>
        <div class="tool-terminal" aria-hidden="true">
          <div class="tool-terminal-bar">
            <span>● ● ●</span>
            <b>{t.viewer[0]}</b>
            <span>⤢</span>
          </div>
          <div class="tool-terminal-art">
            <img src="/assets/brake-pads.svg" alt="" />
            <div></div>
          </div>
          <div class="tool-terminal-foot">
            <b>{t.viewer[1]}</b>
            <span>{t.viewer[2]}</span>
          </div>
        </div>
      </div>
    </section>
    <section class="tool-section" id="tool-figures" tabindex="-1">
      <div class="tool-bound">
        <div class="tool-head">
          <p class="tool-label">{t.figuresLabel}</p>
          <h2>{t.figuresTitle}</h2>
          <p class="tool-copy">{t.figuresText}</p>
        </div>
        <div class="tool-browser" data-picker>
          <div class="tool-browser-art">
            <img data-picker-image loading="lazy" src={figures[0].image} alt={figures[0].alt} />
            <span data-picker-caption>{figures[0].caption}</span>
          </div>
          <div class="tool-browser-body">
            <div class="tool-choices" role="group" aria-label={t.choose}>
              {figures.map((figure, index) => (
                <button
                  type="button"
                  aria-pressed={index === 0 ? 'true' : 'false'}
                  data-pick={index}
                  data-image={figure.image}
                  data-alt={figure.alt}
                  data-caption={figure.caption}
                >
                  {figure.label}
                </button>
              ))}
            </div>
            <div aria-live="polite" data-picker-text>
              <FigureNotes figure={figures[0]} />
            </div>
            {figures.map((figure, index) => (
              <template data-option={index}>
                <FigureNotes figure={figure} />
              </template>
            ))}
          </div>
        </div>
        <div class="tool-pair">
          <article>
            <div class="tool-lineart">
              <svg
                class="tool-icon"
                viewBox="0 0 32 32"
                fill="none"
                stroke="currentColor"
                stroke-width="1.45"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <rect x="3" y="7" width="26" height="18" rx="2" />
                <path d="M8 11v10m3-10v10m4-10v10m5-10v10m3-10v10" />
              </svg>
            </div>
            <h3>{t.pair.vehicle[0]}</h3>
            <p>{t.pair.vehicle[1]}</p>
            <a class="tool-textlink" href={link('/guides/vehicle-identification/')}>
              {t.pair.vehicle[2]}
            </a>
          </article>
          <article>
            <div class="tool-lineart">
              <svg
                class="tool-icon"
                viewBox="0 0 32 32"
                fill="none"
                stroke="currentColor"
                stroke-width="1.45"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="m12 20 8-8m-6-4 3-3a7 7 0 1 1 10 10l-4 4m-5 5-3 3A7 7 0 1 1 5 17l4-4" />
              </svg>
            </div>
            <h3>{t.pair.separate[0]}</h3>
            <p>{t.pair.separate[1]}</p>
          </article>
        </div>
      </div>
    </section>
    <section class="tool-section tool-center tool-muted">
      <div class="tool-bound">
        <div class="tool-head">
          <p class="tool-label">{t.callout.label}</p>
          <h2>{t.callout.title}</h2>
        </div>
        <div class="tool-darkrows">
          <article>
            <div class="tool-glyph">
              <svg
                class="tool-icon"
                viewBox="0 0 32 32"
                fill="none"
                stroke="currentColor"
                stroke-width="1.45"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <rect x="4" y="4" width="10" height="10" rx="1" />
                <rect x="18" y="4" width="10" height="10" rx="1" />
                <rect x="4" y="18" width="10" height="10" rx="1" />
                <rect x="18" y="18" width="10" height="10" rx="1" />
              </svg>
            </div>
            <div>
              <h3>{t.callout.rows[0][0]}</h3>
              <p>{t.callout.rows[0][1]}</p>
            </div>
          </article>
          <article>
            <div class="tool-glyph">
              <svg
                class="tool-icon"
                viewBox="0 0 32 32"
                fill="none"
                stroke="currentColor"
                stroke-width="1.45"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="m2 11 14-7 14 7-14 7zm1 6 13 7 13-7M3 23l13 7 13-7" />
              </svg>
            </div>
            <div>
              <h3>{t.callout.rows[1][0]}</h3>
              <p>{t.callout.rows[1][1]}</p>
            </div>
          </article>
          <article>
            <div class="tool-glyph">
              <svg
                class="tool-icon"
                viewBox="0 0 32 32"
                fill="none"
                stroke="currentColor"
                stroke-width="1.45"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M8 3h13l5 5v21H8zM21 3v6h5M12 14h10m-10 5h10m-10 5h6" />
              </svg>
            </div>
            <div>
              <h3>{t.callout.rows[2][0]}</h3>
              <p>{t.callout.rows[2][1]}</p>
            </div>
          </article>
        </div>
      </div>
    </section>
    <section class="tool-section">
      <div class="tool-bound">
        <div class="tool-columns">
          <div class="tool-head">
            <p class="tool-label">{t.housing.label}</p>
            <h2>{t.housing.title}</h2>
            <p class="tool-copy">{t.housing.text}</p>
          </div>
          <dl class="tool-field-notes">
            {t.housing.notes.map(([term, detail]) => (
              <div>
                <dt>{term}</dt>
                <dd>{detail}</dd>
              </div>
            ))}
          </dl>
        </div>
      </div>
    </section>
    <section class="tool-section">
      <div class="tool-bound">
        <div class="tool-head">
          <p class="tool-label">{t.desk.label}</p>
          <h2>{t.desk.title}</h2>
        </div>
        <div class="tool-deck">
          <a href={link(deckLinks[0])}>
            <span>{t.desk.cards[0][0]}</span>
            <svg
              class="tool-icon"
              viewBox="0 0 32 32"
              fill="none"
              stroke="currentColor"
              stroke-width="1.45"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M4 19c0-6 5-11 15-11h6c2 0 3 2 3 5v4c0 4-2 6-6 6H9l-5 3zm4 0c0-4 3-7 11-7h5" />
            </svg>
            <h3>{t.desk.cards[0][1]}</h3>
          </a>
          <a href={link(deckLinks[1])}>
            <span>{t.desk.cards[1][0]}</span>
            <svg
              class="tool-icon"
              viewBox="0 0 32 32"
              fill="none"
              stroke="currentColor"
              stroke-width="1.45"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <rect x="3" y="7" width="26" height="18" rx="2" />
              <path d="M8 11v10m3-10v10m4-10v10m5-10v10m3-10v10" />
            </svg>
            <h3>{t.desk.cards[1][1]}</h3>
          </a>
          <a href={link(deckLinks[2])}>
            <span>{t.desk.cards[2][0]}</span>
            <svg
              class="tool-icon"
              viewBox="0 0 32 32"
              fill="none"
              stroke="currentColor"
              stroke-width="1.45"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M3 5h24v17H14l-8 5v-5H3zM8 11h14m-14 5h9" />
            </svg>
            <h3>{t.desk.cards[2][1]}</h3>
          </a>
        </div>
      </div>
    </section>
    <ClosingBand
      title={t.closing.title}
      text={t.closing.text}
      primary={{ href: link('/tools/part-details/'), label: t.closing.primary }}
      secondary={{ href: link('/guides/counter/'), label: t.closing.secondary }}
    />
  </div>
</Layout>

<script>
  import '../../scripts/picker.js';
</script>
