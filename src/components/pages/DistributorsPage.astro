---
import Layout from '../../layouts/Layout.astro';
import { contactLink } from '../../site';
import ContactBand from '../ContactBand.astro';
import { distributors } from '../../i18n/pages/distributors';
import { localizedPath, ui } from '../../i18n/ui';

interface Props {
  locale: keyof typeof ui;
}

const { locale } = Astro.props;
const t = distributors[locale];
const link = (href: string) => localizedPath(locale, href);
const questions = t.slider.questions;
const ask = (part: string) => t.slider.ask.replace('{part}', part);
const filters = Object.keys(t.directory.filters) as (keyof typeof t.directory.filters)[];
const resourceLinks = [
  '/guides/vehicle-identification/',
  '/tools/part-details/',
  '/tools/parts-diagrams/',
];
const stepLinks = [
  '/about/',
  '/guides/vehicle-identification/',
  '/tools/part-details/',
  '/guides/counter/',
];
---

<Layout title={t.title} description={t.description}>
  <div class="team-page team-dist">
    <section class="team-hero">
      <div class="team-frame">
        <p class="team-label">{t.label}</p>
        <h1 tabindex="-1">{t.heading}</h1>
        <p class="team-hero-note">{t.heroNote}</p>
        <div class="team-actions">
          <a class="team-btn" href={contactLink}>
            {t.talk}
          </a>
          <button type="button" class="team-btn team-secondary" data-jump="team-directory">
            {t.byPart}
          </button>
        </div>
      </div>
    </section>
    <section class="team-dist-section">
      <div class="team-frame team-overview">
        <div>
          <p class="team-label">{t.overview.label}</p>
          <h2 class="team-h2">{t.overview.title}</h2>
          <p>{t.overview.text}</p>
        </div>
        <ol class="team-numbered">
          {t.overview.steps.map(([title, text], i) => (
            <li>
              <span aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <!-- prettier-ignore -->
              <div><strong>{title}</strong>{text}</div>
            </li>
          ))}
        </ol>
      </div>
    </section>
    <section
      class="team-quote-slider"
      aria-label={t.slider.label}
      data-team-slider
      data-questions={JSON.stringify(questions)}
      data-ask={t.slider.ask}
    >
      <div class="team-slide-copy">
        <div class="team-slide-mark">
          <img src="/assets/symbol.svg" alt="" /> Parts Relay
        </div>
        <div aria-live="off" data-team-slide-body>
          <blockquote>{questions[0].text}</blockquote>
          <p>{ask(questions[0].part)}</p>
        </div>
      </div>
      <div class="team-slide-controls">
        {t.slider.show.map((label, i) => (
          <button
            type="button"
            data-team-slide={String(i)}
            aria-label={label}
            aria-pressed={i === 0 ? 'true' : 'false'}
          >
            <i />
          </button>
        ))}
        <button
          type="button"
          class="team-play"
          data-team-pause
          aria-label={t.slider.pause}
          aria-pressed="false"
          data-pause-label={t.slider.pause}
          data-play-label={t.slider.play}
        >
          Ⅱ
        </button>
      </div>
    </section>
    <section class="team-dist-section">
      <div class="team-frame">
        <p class="team-label">{t.reference.label}</p>
        <h2 class="team-h2">{t.reference.title}</h2>
        <div class="team-resources">
          {t.reference.links.map(([title, text], i) => (
            <a href={link(resourceLinks[i])}>
              <h3>{title}</h3>
              <p>{text}</p>
            </a>
          ))}
        </div>
      </div>
    </section>
    <section class="team-dist-section team-directory" id="team-directory" tabindex="-1">
      <div class="team-frame">
        <p class="team-label">{t.directory.label}</p>
        <div class="team-filter-line">
          <h2 class="team-h2">{t.byPart}</h2>
          <div class="team-filters" role="group" aria-label={t.directory.filtersLabel}>
            {filters.map((filter) => (
              <button
                type="button"
                aria-pressed={filter === 'All' ? 'true' : 'false'}
                data-team-filter={filter}
              >
                {t.directory.filters[filter]}
              </button>
            ))}
          </div>
        </div>
        <div class="team-parts-grid" aria-label={t.directory.gridLabel}>
          <details class="team-part" data-team-category="Brakes">
            <summary>
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.35"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <circle cx="12" cy="12" r="8.5" />
                <circle cx="12" cy="12" r="2.8" />
                <path d="M6 7.5c1.6-1.5 3-2.2 5-2.3M16.5 17.4l1.6-1.7M14 19l.8-.3" />
              </svg>
              <span>{t.directory.parts[0][0]}</span>
              <i aria-hidden="true">+</i>
            </summary>
            <p>{t.directory.parts[0][1]}</p>
          </details>
          <details class="team-part" data-team-category="Electrical">
            <summary>
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.35"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M4 7h16v13H4zM6 7V4h4v3m4 0V4h4v3M7 11h4m-2-2v4m5-2h3" />
              </svg>
              <span>{t.directory.parts[1][0]}</span>
              <i aria-hidden="true">+</i>
            </summary>
            <p>{t.directory.parts[1][1]}</p>
          </details>
          <details class="team-part" data-team-category="Body">
            <summary>
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.35"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M2 18v-5l7-8h9l3 3v10zM5.5 12l4.3-4.8H17l1.8 2V12zM15 15h3" />
              </svg>
              <span>{t.directory.parts[2][0]}</span>
              <i aria-hidden="true">+</i>
            </summary>
            <p>{t.directory.parts[2][1]}</p>
          </details>
          <details class="team-part" data-team-category="Cooling">
            <summary>
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.35"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <rect x="4" y="6" width="16" height="13" rx="1" />
                <path d="M6 4v2m12-2v2M8 8v9m4-9v9m4-9v9M2 9h2m16 7h2" />
              </svg>
              <span>{t.directory.parts[3][0]}</span>
              <i aria-hidden="true">+</i>
            </summary>
            <p>{t.directory.parts[3][1]}</p>
          </details>
          <details class="team-part" data-team-category="Electrical">
            <summary>
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.35"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M4 7h16v13H4zM6 7V4h4v3m4 0V4h4v3M7 11h4m-2-2v4m5-2h3" />
              </svg>
              <span>{t.directory.parts[4][0]}</span>
              <i aria-hidden="true">+</i>
            </summary>
            <p>{t.directory.parts[4][1]}</p>
          </details>
          <details class="team-part" data-team-category="Body">
            <summary>
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.35"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M2 18v-5l7-8h9l3 3v10zM5.5 12l4.3-4.8H17l1.8 2V12zM15 15h3" />
              </svg>
              <span>{t.directory.parts[5][0]}</span>
              <i aria-hidden="true">+</i>
            </summary>
            <p>{t.directory.parts[5][1]}</p>
          </details>
          <details class="team-part" data-team-category="Cooling">
            <summary>
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.35"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <rect x="4" y="6" width="16" height="13" rx="1" />
                <path d="M6 4v2m12-2v2M8 8v9m4-9v9m4-9v9M2 9h2m16 7h2" />
              </svg>
              <span>{t.directory.parts[6][0]}</span>
              <i aria-hidden="true">+</i>
            </summary>
            <p>{t.directory.parts[6][1]}</p>
          </details>
          <details class="team-part" data-team-category="Brakes">
            <summary>
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.35"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <circle cx="12" cy="12" r="8.5" />
                <circle cx="12" cy="12" r="2.8" />
                <path d="M6 7.5c1.6-1.5 3-2.2 5-2.3M16.5 17.4l1.6-1.7M14 19l.8-.3" />
              </svg>
              <span>{t.directory.parts[7][0]}</span>
              <i aria-hidden="true">+</i>
            </summary>
            <p>{t.directory.parts[7][1]}</p>
          </details>
        </div>
        <span class="team-sr" role="status" data-team-count data-count={t.directory.count}></span>
      </div>
    </section>
    <section class="team-dist-section">
      <div class="team-frame team-intake">
        <div>
          <p class="team-label">{t.queue.label}</p>
          <h2 class="team-h2">{t.queue.title}</h2>
          {t.queue.text.map((text) => (
            <p>{text}</p>
          ))}
        </div>
        <section class="team-record">
          <h3>{t.queue.recordTitle}</h3>
          <dl>
            {t.queue.statuses.map(([term, detail]) => (
              <div>
                <dt>{term}</dt>
                <dd>{detail}</dd>
              </div>
            ))}
          </dl>
        </section>
      </div>
    </section>
    <section class="team-dist-section team-reply-sheet">
      <div class="team-frame team-intake">
        <div>
          <p class="team-label">{t.reply.label}</p>
          <h2 class="team-h2">{t.reply.title}</h2>
          {t.reply.text.map((text) => (
            <p>{text}</p>
          ))}
        </div>
        <section class="team-record">
          <h3>{t.reply.recordTitle}</h3>
          <dl>
            {t.reply.record.map(([term, detail]) => (
              <div>
                <dt>{term}</dt>
                <dd>{detail}</dd>
              </div>
            ))}
          </dl>
        </section>
      </div>
    </section>
    <section class="team-dist-section">
      <div class="team-frame">
        <p class="team-label">{t.steps.label}</p>
        <h2 class="team-h2">{t.steps.title}</h2>
        <div class="team-steps">
          {t.steps.items.map(([title, stage, text], i) => (
            <a href={link(stepLinks[i])} style={`--team-step: ${i}`}>
              <span>{String(i + 1).padStart(2, '0')}</span>
              <h3>{title}</h3>
              <small>{stage}</small>
              <p>{text}</p>
            </a>
          ))}
        </div>
      </div>
    </section>
    <ContactBand />
  </div>
</Layout>

<script>
  import '../../scripts/distributors.js';
</script>
