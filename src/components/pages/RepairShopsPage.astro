---
import Layout from '../../layouts/Layout.astro';
import { contactLink } from '../../site';
import ContactBand from '../ContactBand.astro';
import { repairShops } from '../../i18n/pages/repairShops';
import { localizedPath, ui } from '../../i18n/ui';

interface Props {
  locale: keyof typeof ui;
}

const { locale } = Astro.props;
const t = repairShops[locale];
const link = (href: string) => localizedPath(locale, href);
const principles = t.principles.items;
---

<Layout title={t.title} description={t.description}>
  <div class="team-page team-shops">
    <section class="team-hero">
      <div class="team-frame">
        <p class="team-label">{t.label}</p>
        <h1 tabindex="-1">{t.heading}</h1>
        <p class="team-hero-note">{t.heroNote}</p>
        <div class="team-actions">
          <a class="team-btn" href={contactLink}>
            {t.talk}
          </a>
        </div>
      </div>
    </section>
    <section class="team-section team-shop-intro">
      <div class="team-frame team-intake">
        <div>
          <p class="team-label">{t.intro.label}</p>
          <h2 class="team-h2">{t.intro.title}</h2>
          {t.intro.text.map((text) => (
            <p>{text}</p>
          ))}
        </div>
        <section class="team-record">
          <h3>{t.intro.recordTitle}</h3>
          <dl>
            {t.intro.record.map(([term, detail]) => (
              <div>
                <dt>{term}</dt>
                <dd>{detail}</dd>
              </div>
            ))}
          </dl>
        </section>
      </div>
    </section>
    <section class="team-section team-principles">
      <div class="team-frame">
        <p class="team-label">{t.principles.label}</p>
        <h2 class="team-h2">{t.principles.title}</h2>
        <ul>
          <li>
            <div class="team-principle-name">
              <span>
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.35"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="m3 13 2-5h12l4 5v5H3zM3 13h18M6 18v2m12-2v2M6 15h2m8 0h2" />
                </svg>
              </span>
              <h3>{principles[0][0]}</h3>
            </div>
            <p>{principles[0][1]}</p>
          </li>
          <li>
            <div class="team-principle-name">
              <span>
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.35"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="m12 2 8 4v11l-8 5-8-5V6zM4 6l8 5 8-5m-8 5v11M8 4l8 5" />
                </svg>
              </span>
              <h3>{principles[1][0]}</h3>
            </div>
            <p>{principles[1][1]}</p>
          </li>
          <li>
            <div class="team-principle-name">
              <span>
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.35"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M3 4h9l9 9-8 8-10-10z" />
                  <circle cx="7.5" cy="8" r="1.2" />
                </svg>
              </span>
              <h3>{principles[2][0]}</h3>
            </div>
            <p>{principles[2][1]}</p>
          </li>
          <li>
            <div class="team-principle-name">
              <span>
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.35"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M3 4h18v12H10l-5 4v-4H3zM7 8h10M7 12h6" />
                </svg>
              </span>
              <h3>{principles[3][0]}</h3>
            </div>
            <p>{principles[3][1]}</p>
          </li>
        </ul>
      </div>
    </section>
    <section class="team-section">
      <div class="team-frame team-intake">
        <div>
          <p class="team-label">{t.sending.label}</p>
          <h2 class="team-h2">{t.sending.title}</h2>
          <p>{t.sending.text}</p>
        </div>
        <section class="team-record">
          <h3>{t.sending.recordTitle}</h3>
          <dl>
            {t.sending.record.map(([term, detail]) => (
              <div>
                <dt>{term}</dt>
                <dd>{detail}</dd>
              </div>
            ))}
          </dl>
        </section>
      </div>
    </section>
    <section class="team-section team-shop-start" id="team-shop-start" tabindex="-1">
      <div class="team-frame">
        <p class="team-label">{t.estimate.label}</p>
        <h2 class="team-h2">{t.estimate.title}</h2>
        <div class="team-shop-example">
          <div>
            <h3>{t.estimate.exampleTitle}</h3>
            <p>{t.estimate.exampleText}</p>
            <a class="team-btn" href={link('/tools/vin-check/')}>
              {t.estimate.checkVin}
            </a>
          </div>
          <section class="team-record">
            <h3>{t.estimate.recordTitle}</h3>
            <dl>
              {t.estimate.record.map(([term, detail]) => (
                <div>
                  <dt>{term}</dt>
                  <dd>{detail}</dd>
                </div>
              ))}
            </dl>
          </section>
        </div>
      </div>
    </section>
    <ContactBand />
  </div>
</Layout>
