---
import Layout from '../../layouts/Layout.astro';
import Arrow from '../Arrow.astro';
import { guidebook } from '../../i18n/pages/guidebook';
import { localizedPath, ui } from '../../i18n/ui';

interface Props {
  locale: keyof typeof ui;
}

const { locale } = Astro.props;
const t = guidebook[locale];
const link = (href: string) => localizedPath(locale, href);
const [firstBefore, firstLink, firstAfter] = t.firstStep;
---

<Layout title={t.title} description={t.description}>
  <div class="lib-page lib-docs">
    <div class="lib-docwrap">
      <aside class="lib-docside">
        <nav aria-label={t.navLabel}>
          <p>{t.nav.quickstart}</p>
          <a class="lib-current" href={link('/guides/guidebook/')} aria-current="page">
            {t.nav.prepare}
          </a>
          <a href={link('/tools/vin-check/')}>{t.nav.vin}</a>
          <p>{t.nav.reference}</p>
          <a href={link('/guides/vehicle-identification/')}>{t.nav.vehicle}</a>
          <a href={link('/tools/part-details/')}>{t.nav.details}</a>
          <a href={link('/tools/parts-diagrams/')}>{t.nav.diagrams}</a>
          <a href={link('/guides/counter/')}>{t.nav.counter}</a>
          <p>{t.nav.training}</p>
          <a href={link('/workshops/')}>{t.nav.workshops}</a>
          <a href={link('/library/')}>{t.nav.library}</a>
        </nav>
      </aside>
      <article class="lib-docbody">
        <header>
          <span class="lib-quick-label">{t.label}</span>
          <h1 tabindex="-1">{t.heading}</h1>
          <p>{t.intro}</p>
        </header>
        <section class="lib-doc-try">
          <h2>{t.prepareTitle}</h2>
          <ol class="lib-steps">
            <li>
              {firstBefore}
              <a class="lib-inline-link" href={link('/tools/vin-check/')}>
                {firstLink}
              </a>
              {firstAfter}
            </li>
            <li>{t.steps[0]}</li>
            <li>{t.steps[1]}</li>
          </ol>
          <a class="lib-action" href={link('/tools/vin-check/')}>
            {t.checkVin}
            <Arrow />
          </a>
        </section>
        <section class="lib-doc-try">
          <h2>{t.quoteTitle}</h2>
          <p>{t.quoteText}</p>
          <p>
            {t.sideText}
            <a class="lib-inline-link" href={link('/tools/part-details/')}>
              {t.sideLink}
            </a>
          </p>
        </section>
        <section class="lib-doc-try">
          <h2>{t.questionsTitle}</h2>
          <div class="lib-doc-grid">
            <a href={link('/guides/vehicle-identification/')}>
              <svg
                aria-hidden="true"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.55"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <rect x="2" y="5" width="20" height="14" rx="2" />
                <path d="M6 9v6m3-6v6m3-6v6m4-6v6m3-6v6" />
              </svg>
              <h3>{t.questions[0][0]}</h3>
              <p>{t.questions[0][1]}</p>
            </a>
            <a href={link('/tools/part-details/')}>
              <svg
                aria-hidden="true"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.55"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="m9 3-5 6 2 8 8 4 6-5-1-8z" />
                <circle cx="12" cy="12" r="3" />
              </svg>
              <h3>{t.questions[1][0]}</h3>
              <p>{t.questions[1][1]}</p>
            </a>
            <a href={link('/repair-shops/')}>
              <svg
                aria-hidden="true"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.55"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M5 3h11l3 3v15H5zM8 9h8m-8 4h6m-6 4h4" />
              </svg>
              <h3>{t.questions[2][0]}</h3>
              <p>{t.questions[2][1]}</p>
            </a>
            <a href={link('/guides/counter/')}>
              <svg
                aria-hidden="true"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.55"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M3 4h16v11H9l-6 4zm7 14h6l5 3V9" />
              </svg>
              <h3>{t.questions[3][0]}</h3>
              <p>{t.questions[3][1]}</p>
            </a>
          </div>
        </section>
        <p class="lib-product-note">
          {t.productNote}
          <a class="lib-inline-link" href={link('/about/')}>
            {t.productLink}
          </a>
        </p>
        <a class="lib-next" href={link('/workshops/first-request/')}>
          <span>
            <small>{t.nextLabel}</small>
            <strong>{t.nextTitle}</strong>
          </span>
          <Arrow />
        </a>
      </article>
    </div>
  </div>
</Layout>
