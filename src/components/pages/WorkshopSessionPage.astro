---
import Workshop from '../../layouts/Workshop.astro';
import { workshopSessions } from '../../i18n/pages/workshopSessions';
import { localizedPath, ui } from '../../i18n/ui';

interface Props {
  locale: keyof typeof ui;
  session: 'firstRequest' | 'fitCheck' | 'handoff';
}

const { locale, session } = Astro.props;
const t = workshopSessions[locale][session];
// Worksheets are downloads in English and keep the same address in every language.
const files = {
  firstRequest: {
    poster: '/assets/workshop.webp',
    worksheet: '/worksheets/parts-relay-first-request-worksheet.md',
    download: 'Parts-Relay-first-request-worksheet.md',
    link: '/tools/vin-check/',
  },
  fitCheck: {
    poster: '/assets/alternator.svg',
    worksheet: '/worksheets/parts-relay-fit-check-worksheet.md',
    download: 'Parts-Relay-fit-check-worksheet.md',
    link: '/journal/alternator-labels/',
  },
  handoff: {
    poster: '/assets/counter.webp',
    worksheet: '/worksheets/parts-relay-handoff-worksheet.md',
    download: 'Parts-Relay-handoff-worksheet.md',
    link: '/guides/counter/',
  },
}[session];
---

<Workshop
  title={t.title}
  description={t.description}
  heading={t.heading}
  audience={t.audience}
  poster={files.poster}
  posterAlt={t.posterAlt}
  prepare={t.prepare}
>
  <Fragment slot="intro">{t.intro}</Fragment>
  <section class="workshop-materials">
    <h2>{t.materials.title}</h2>
    <p>{t.materials.text}</p>
    <div>
      <a href={files.worksheet} download={files.download}>
        {t.materials.download}
      </a>
      <a href={localizedPath(locale, files.link)}>{t.materials.link}</a>
    </div>
  </section>
  <section class="workshop-agenda">
    <h2>{t.scenario.title}</h2>
    <p>{t.scenario.text}</p>
    <h2>{t.stepsTitle}</h2>
    <ol>
      {t.steps.map((step) => (
        <li>
          <h3>{step.title}</h3>
          <p>{step.text}</p>
        </li>
      ))}
    </ol>
    <h2>{t.answerTitle}</h2>
    <dl class="workshop-answer">
      {t.answers.map((answer) => (
        <div>
          <dt>{answer.term}</dt>
          <dd>{answer.text}</dd>
        </div>
      ))}
    </dl>
    <h2>{t.check.title}</h2>
    <p>{t.check.text}</p>
    <h2>{t.variant.title}</h2>
    <p>{t.variant.text}</p>
  </section>
</Workshop>
