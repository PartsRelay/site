---
import Layout from '../../layouts/Layout.astro';
import Arrow from '../Arrow.astro';
import { library } from '../../i18n/pages/library';
import { localizedPath, ui } from '../../i18n/ui';

interface Props {
  locale: keyof typeof ui;
}

const { locale } = Astro.props;
const t = library[locale];
const link = (href: string) => localizedPath(locale, href);

type Topic = keyof typeof t.filters;
const filters: Topic[] = ['All', 'Guides', 'Tools', 'Workflows', 'Workshops', 'Journal'];

// Each entry in the list, in the same order as the text in t.items.
const entries: { topic: Topic; href: string; tone: string; icon: string }[] = [
  {
    topic: 'Tools',
    href: '/tools/vin-check/',
    tone: 'vin',
    icon: '<rect x="2" y="5" width="20" height="14" rx="2"></rect><path d="M6 9v6m3-6v6m3-6v6m4-6v6m3-6v6"></path>',
  },
  {
    topic: 'Guides',
    href: '/guides/guidebook/',
    tone: 'book',
    icon: '<path d="M3 5c4-1 6 0 9 2 3-2 5-3 9-2v14c-4-1-6 0-9 2-3-2-5-3-9-2zM12 7v14"></path>',
  },
  {
    topic: 'Workflows',
    href: '/repair-shops/',
    tone: 'shop',
    icon: '<path d="M2 11 12 4l10 7M5 10v11m14-11v11M8 21v-7h8v7m-8-4h8"></path>',
  },
  {
    topic: 'Workflows',
    href: '/distributors/',
    tone: 'counter',
    icon: '<path d="M3 11h18v9H3zM5 7h8v4M5 17h6m5-11h4v5"></path>',
  },
  {
    topic: 'Guides',
    href: '/tools/parts-diagrams/',
    tone: 'diagram',
    icon: '<path d="m3 7 9-4 9 4-9 4zM3 12l9 4 9-4M3 17l9 4 9-4"></path>',
  },
  {
    topic: 'Guides',
    href: '/guides/vehicle-identification/',
    tone: 'vin',
    icon: '<rect x="2" y="5" width="20" height="14" rx="2"></rect><path d="M6 9v6m3-6v6m3-6v6m4-6v6m3-6v6"></path>',
  },
  {
    topic: 'Guides',
    href: '/tools/part-details/',
    tone: 'part',
    icon: '<path d="m9 3-5 6 2 8 8 4 6-5-1-8z"></path><circle cx="12" cy="12" r="3"></circle>',
  },
  {
    topic: 'Guides',
    href: '/guides/counter/',
    tone: 'chat',
    icon: '<path d="M3 4h16v11H9l-6 4zm7 14h6l5 3V9"></path>',
  },
  {
    topic: 'Workshops',
    href: '/workshops/',
    tone: 'learn',
    icon: '<path d="m2 8 10-5 10 5-10 5zm4 3v6l6 3 6-3v-6"></path>',
  },
  {
    topic: 'Journal',
    href: '/journal/',
    tone: 'book',
    icon: '<path d="M3 5c4-1 6 0 9 2 3-2 5-3 9-2v14c-4-1-6 0-9 2-3-2-5-3-9-2zM12 7v14"></path>',
  },
];

const pathLinks = ['/guides/vehicle-identification/', '/tools/parts-diagrams/', '/guides/counter/'];
---

<Layout title={t.title} description={t.description}>
  <div class="lib-page lib-library" data-lib-list>
    <div class="lib-bound">
      <header class="lib-directory-intro">
        <h1 tabindex="-1">{t.heading}</h1>
        <p>{t.intro}</p>
      </header>
      <div class="lib-controls">
        <div class="lib-tabs" role="group" aria-label={t.filterLabel}>
          {filters.map((topic) => (
            <button
              type="button"
              data-lib-filter={topic}
              aria-pressed={topic === 'All' ? 'true' : 'false'}
            >
              {t.filters[topic]}
            </button>
          ))}
        </div>
        <label class="lib-search">
          <svg
            aria-hidden="true"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.55"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <circle cx="10.5" cy="10.5" r="6.5"></circle>
            <path d="m16 16 5 5"></path>
          </svg>
          <span class="lib-visually-hidden">{t.searchLabel}</span>
          <input
            type="search"
            placeholder={t.searchPlaceholder}
            autocomplete="off"
            data-lib-search
          />
        </label>
      </div>
      <ul class="lib-rows" data-lib-results>
        {entries.map((entry, index) => (
          <li data-lib-item data-lib-topic={entry.topic}>
            <a href={link(entry.href)}>
              <span class={`lib-icon lib-tone-${entry.tone}`}>
                <svg
                  aria-hidden="true"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.55"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  set:html={entry.icon}
                />
              </span>
              <span class="lib-row-label">
                <strong>{t.items[index][0]}</strong>
                <span>{t.items[index][1]}</span>
              </span>
              <span class="lib-row-tags">
                <span>{t.filters[entry.topic]}</span>
                <span>{t.items[index][2]}</span>
              </span>
              <span class="lib-open">
                <Arrow />
              </span>
            </a>
          </li>
        ))}
      </ul>
      <p
        class="lib-visually-hidden"
        aria-live="polite"
        data-lib-count
        data-lib-count-one={t.count[0]}
        data-lib-count-other={t.count[1]}
      ></p>
      <div class="lib-empty" data-lib-empty hidden>
        <h2>{t.emptyTitle}</h2>
        <p>{t.emptyText}</p>
        <button type="button" data-lib-reset>
          {t.reset}
        </button>
      </div>
      <section class="lib-desk-paths">
        <h2>{t.pathsTitle}</h2>
        <div>
          {t.paths.map(([heading, text, label], index) => (
            <article>
              <h3>{heading}</h3>
              <p>{text}</p>
              <a class="lib-inline-link" href={link(pathLinks[index])}>
                {label}
                <Arrow />
              </a>
            </article>
          ))}
        </div>
      </section>
    </div>
  </div>
</Layout>

<script>
  import '../../scripts/library.js';
</script>
