---
import { uiUrl } from '../facts'
import { translator } from '../i18n'
import Section from './Section.astro'

const t = translator(Astro.currentLocale)
---

<Section id="start">
  <div class="flex flex-wrap items-start justify-between gap-x-18 gap-y-10">
    <div class="flex min-w-0 flex-[1_1_23.75rem] flex-col gap-4">
      <h2
        class="text-[clamp(2.2rem,4vw,3.4rem)] leading-[1.05] font-extrabold tracking-[-0.03em] text-balance"
      >
        {t('site.start.title')}
      </h2>
      <p class="max-w-[28em] text-xl text-slate">{t('site.start.text')}</p>
    </div>
    <div class="plate flex min-w-0 flex-[0_1_26.25rem] flex-col gap-4 p-8">
      <h3 class="text-[1.375rem] font-bold tracking-[-0.01em]">{t('site.start.card.title')}</h3>
      <p class="text-slate">{t('site.start.card.text')}</p>
      <a href={`${uiUrl}/login`} class="button text-center text-lg">{t('site.sign-in')}</a>
    </div>
  </div>
</Section>
