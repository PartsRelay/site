---
import { appUrl } from '../facts'
import Section from './Section.astro'
---

<Section id="start">
  <div class="flex flex-wrap items-start justify-between gap-x-18 gap-y-10">
    <div class="flex min-w-0 flex-[1_1_23.75rem] flex-col gap-4">
      <h2
        class="text-[clamp(2.2rem,4vw,3.4rem)] leading-[1.05] font-extrabold tracking-[-0.03em] text-balance"
      >
        Open your counter
      </h2>
      <p class="max-w-[28em] text-xl text-slate">
        Sign in and land in the app. There is no password to remember, and your first sign in
        creates your company.
      </p>
    </div>
    <div class="plate flex min-w-0 flex-[0_1_26.25rem] flex-col gap-4 p-8">
      <h3 class="text-[1.375rem] font-bold tracking-[-0.01em]">Sign in to Parts Relay</h3>
      <p class="text-slate">With Google, or with a link sent to your email.</p>
      <a href={`${appUrl}/login`} class="button text-center text-lg">Sign in</a>
    </div>
  </div>
</Section>
