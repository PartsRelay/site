---
import { bookCallLink, trialDays, trialLink } from '../site';
import { home } from '../i18n/home';
import { localeOf } from '../i18n/ui';

const locale = localeOf(Astro.url) as keyof typeof home;
const t = home[locale];
---

<section class="team-cta">
  <div class="team-frame">
    <h2 class="team-h2">{t.ctaTitle}</h2>
    <p>{t.ctaText.replace('{days}', String(trialDays))}</p>
    <div class="team-actions">
      <a class="team-btn" href={trialLink}>
        <img src="/assets/symbol.svg" alt="" />
        {t.trial}
      </a>
      <a class="team-btn team-secondary" href={bookCallLink}>
        {t.bookCall}
      </a>
    </div>
  </div>
</section>
