---
import { contactEmail, contactLink } from '../site';
---

<section class="team-cta">
  <div class="team-frame">
    <h2 class="team-h2">See whether it covers the jobs you get</h2>
    <p>
      Write to {contactEmail} with two recent enquiries, one you answered easily and one that took
      another phone call, and the country your vehicles are registered in. We can check them against
      catalogue coverage.
    </p>
    <div class="team-actions">
      <a class="team-btn" href={contactLink}>
        <img src="/assets/symbol.svg" alt="" />
        Email the Parts Relay team
      </a>
      <a class="team-btn team-secondary" href="/about/">
        How Parts Relay works
      </a>
    </div>
  </div>
</section>
