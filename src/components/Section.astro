---
import { sections } from '../facts'
import { translator } from '../i18n'

interface Props {
  id: string
}

const { id } = Astro.props
const t = translator(Astro.currentLocale)
---

<section id={id} class="mx-auto flex max-w-[70rem] flex-col gap-9 px-8 pb-28">
  <p class="label flex gap-4 border-t border-navy pt-3.5">
    <span class="text-teal">{String(sections.indexOf(id) + 1).padStart(2, '0')}</span>
    {t(`site.${id}.name`)}
  </p>
  <slot />
</section>
