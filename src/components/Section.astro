---
import { sections } from '../facts'

interface Props {
  id: string
}

const { id } = Astro.props
const index = sections.findIndex((section) => section.id === id)
---

<section id={id} class="mx-auto flex max-w-[70rem] flex-col gap-9 px-8 pb-28">
  <p class="label flex gap-4 border-t border-navy pt-3.5">
    <span class="text-teal">{String(index + 1).padStart(2, '0')}</span>
    {sections[index].name}
  </p>
  <slot />
</section>
