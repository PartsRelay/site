---
import { contactLink, privacyPolicy } from '../site';
import { localizedPath, ui } from '../i18n/ui';

interface Props {
  locale: keyof typeof ui;
}

const { locale } = Astro.props;
const t = ui[locale];
const item = (key: string) => t.items[key as keyof typeof t.items];

const menu = [
  {
    id: 'site-solutions',
    label: t.groups.solutions,
    items: [
      {
        key: 'how',
        href: '/#workflow',
        icon: ['M3 6h12v5h6', 'm17 7 4 4-4 4', 'M21 18H9v-5H3', 'm7 9-4 4 4 4'],
      },
      {
        key: 'shops',
        href: '/repair-shops/',
        icon: ['M3 10l2-6h14l2 6H3Zm2 0v10h14V10', 'M8 20v-6h5v6'],
      },
      {
        key: 'vin',
        href: '/tools/vin-check/',
        icon: ['M8 4a6 6 0 1 1 0 12A6 6 0 0 1 8 4Zm5 10 7 7', 'M5 10h1', 'M8 9h1', 'M11 10h1'],
      },
    ],
  },
  {
    id: 'site-resources',
    label: t.groups.resources,
    items: [
      {
        key: 'journal',
        href: '/journal/',
        icon: ['M4 3h16v18H4ZM7 7h10M7 11h10m-10 4h6'],
      },
      {
        key: 'vehicle',
        href: '/guides/vehicle-identification/',
        icon: ['M3 10l2-5h14l2 5v8H3Z', 'M3 11h18', 'M6 15h2m8 0h2'],
      },
      {
        key: 'counter',
        href: '/guides/counter/',
        icon: ['M4 8h16v4H4ZM6 12v7m12-7v7M9 8V4h6v4'],
      },
      {
        key: 'about',
        href: '/about/',
        icon: ['M3 4h18v13h-9l-5 4v-4H3Z', 'M7 12h4V8h6'],
      },
      {
        key: 'brand',
        href: '/brand/',
        icon: ['M3 5h18v14H3ZM7 14l4-5 3 3 2-2 2 4'],
      },
      {
        key: 'privacy',
        href: privacyPolicy,
        external: true,
        icon: ['m12 3 8 3v5q0 6-8 10-8-4-8-10V6Z', 'm8 12 3 3 5-6'],
      },
    ],
  },
];
---

<header class="site-chrome" id="site-chrome">
  <div class="site-banner" aria-label={t.banner.region}>
    <span class="site-ann-wide">{t.banner.wide}</span>
    <span class="site-ann-short">{t.banner.short}</span>
    <span class="site-ann-divider" aria-hidden="true"></span>
    <a href={localizedPath(locale, '/tools/vin-check/')}>
      {t.banner.link} <i class="site-right" aria-hidden="true"></i>
    </a>
    <button class="site-dismiss" type="button" aria-label={t.banner.dismiss}>
      <span aria-hidden="true">×</span>
    </button>
  </div>
  <div class="site-nav-shell">
    <div class="site-nav">
      <a class="site-mark" href={localizedPath(locale, '/')} aria-label={t.nav.home}>
        <img src="/assets/symbol.svg" width="39" height="35" alt="" />
      </a>
      <nav class="site-menu" id="site-menu" aria-label={t.nav.main}>
        {menu.map((group) => (
          <div class="site-group">
            <button
              type="button"
              class="site-trigger"
              aria-expanded="false"
              aria-controls={group.id}
            >
              {group.label} <i />
            </button>
            <div class="site-dropdown" id={group.id} hidden>
              {group.items.map((entry) => (
                <a
                  href={localizedPath(locale, entry.href)}
                  target={entry.external ? '_blank' : undefined}
                  rel={entry.external ? 'noopener' : undefined}
                  aria-label={item(entry.key)[0]}
                  data-key={entry.key}
                >
                  <span class="site-item-icon" aria-hidden="true">
                    <svg
                      width="24"
                      height="24"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.65"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      {entry.icon.map((d) => (
                        <path d={d} />
                      ))}
                    </svg>
                  </span>
                  <span class="site-item-labels">
                    <strong>{item(entry.key)[0]}</strong>
                    <span>{item(entry.key)[1]}</span>
                  </span>
                </a>
              ))}
            </div>
          </div>
        ))}
        <a class="site-mobile-contact" href={contactLink}>
          {t.nav.mobileContact}
        </a>
      </nav>
      <div class="site-nav-side">
        <a class="site-get" href={contactLink}>
          {t.nav.contact} <i class="site-right" aria-hidden="true"></i>
        </a>
        <button
          type="button"
          class="site-mobile"
          aria-controls="site-menu"
          aria-expanded="false"
          aria-label={t.nav.open}
          data-open-label={t.nav.open}
          data-close-label={t.nav.close}
        >
          <i></i>
          <i></i>
        </button>
      </div>
    </div>
  </div>
</header>
