---
import { contactEmail, cookiePolicy, privacyPolicy } from '../site';
import { locales, localizedPath, ui } from '../i18n/ui';

interface Props {
  locale: keyof typeof ui;
  versions: { locale: string; href: string }[];
}

const { locale, versions } = Astro.props;
const t = ui[locale];
const f = t.footer;
const name = (code: string) => locales[code as keyof typeof locales].name;
const year = new Date().getFullYear();
---

<div class="base-bound base-footer-rule">
  <hr />
</div>
<footer class="base-footer">
  <div class="base-bound">
    <div class="base-columns">
      <div class="base-business">
        <a class="base-active" href={localizedPath(locale, '/tools/vin-check/')}>
          <span aria-hidden="true"></span>
          {t.items.vin[0]}
        </a>
        <p>{f.productEnquiries}</p>
        <a class="base-contact" href={`mailto:${contactEmail}`}>
          {contactEmail}
        </a>
        <div class="base-utilities">
          <a
            href={localizedPath(locale, '/tools/vin-check/')}
            title={f.checkVin}
            aria-label={f.checkVin}
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="10" cy="10" r="6.5" />
              <path d="m15 15 6.5 6.5" />
            </svg>
          </a>
          <a href={localizedPath(locale, '/journal/')} title={f.journal} aria-label={f.journal}>
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M3 4.5h5.5c1.4 0 2.7.4 3.5 1.2.8-.8 2.1-1.2 3.5-1.2H21v14h-5.5c-1.5 0-2.6.4-3.5 1.2-.9-.8-2-1.2-3.5-1.2H3zM12 6v13" />
            </svg>
          </a>
        </div>
      </div>
      <div class="base-group">
        <h3>{t.groups.solutions}</h3>
        <a href={localizedPath(locale, '/#workflow')}>{t.items.how[0]}</a>
        <a href={localizedPath(locale, '/pricing/')}>{t.nav.pricing}</a>
        <a href={localizedPath(locale, '/repair-shops/')}>{t.items.shops[0]}</a>
        <a href={localizedPath(locale, '/tools/vin-check/')}>{t.items.vin[0]}</a>
      </div>
      <div class="base-group">
        <h3>{t.groups.resources}</h3>
        <a href={localizedPath(locale, '/journal/')}>{f.journal}</a>
        <a href={localizedPath(locale, '/guides/vehicle-identification/')}>{t.items.vehicle[0]}</a>
        <a href={localizedPath(locale, '/guides/counter/')}>{t.items.counter[0]}</a>
      </div>
      <div class="base-group">
        <h3>{f.company}</h3>
        <a href={localizedPath(locale, '/about/')}>{t.items.about[0]}</a>
        <a href={localizedPath(locale, '/brand/')}>{t.items.brand[0]}</a>
        <a href={privacyPolicy} target="_blank" rel="noopener">
          {t.items.privacy[0]}
        </a>
      </div>
    </div>
    <div class="base-art" aria-hidden="true">
      <svg class="base-wordmark" viewBox="0 0 750 193" focusable="false">
        <title>Parts Relay</title>
        <defs>
          <path id="base-letter-P" d="M0 0H45C71 0 86 16 86 41S72 83 46 83H34V130H0Z" />
          <path
            id="base-letter-a"
            d="M2 62C4 42 19 29 43 29S78 42 78 65V130H50L48 124Q40 132 26 132C9 132 0 120 0 104C0 88 10 77 28 73L44 70Q48 69 48 66Q48 61 42 61Q36 61 34 65Z"
          />
          <path id="base-letter-r" d="M0 32H28L30 41Q37 29 51 29H55V62H47Q33 62 33 78V130H0Z" />
          <path
            id="base-letter-t"
            d="M13 9H45V32H58V59H45V94Q45 103 54 103H60V130H43Q13 130 13 101V59H0V32H13Z"
          />
          <path
            id="base-letter-s"
            d="M2 63C2 40 18 29 40 29C63 29 76 42 77 62H48Q47 55 40 55Q34 55 34 60Q34 63 42 65L55 69Q78 75 78 97C78 120 64 132 39 132C16 132 1 121 0 99H30Q31 106 39 106Q46 106 46 102Q46 98 38 96L25 92Q2 86 2 63Z"
          />
          <path
            id="base-letter-R"
            d="M0 0H45C71 0 86 16 86 41Q86 62 68 74L91 130H54L36 84H34V130H0Z"
          />
          <path
            id="base-letter-e"
            d="M40 29C66 29 80 49 80 78V86H33Q34 101 43 101Q50 101 52 95H79C75 119 60 132 40 132C15 132 0 113 0 81C0 49 16 29 40 29Z"
          />
          <path id="base-letter-l" d="M0 0H32V130H0Z" />
          <path
            id="base-letter-y"
            d="M0 32H33L45 84L57 32H89L59 133Q51 161 28 161H7V133H17Q27 133 29 124Z"
          />
        </defs>
        <g transform="translate(2 29)">
          <g class="base-tile">
            <use href="#base-letter-P" x="0" />
            <use href="#base-letter-a" x="84" />
          </g>
          <g class="base-tile">
            <use href="#base-letter-r" x="164" />
            <use href="#base-letter-t" x="216" />
            <use href="#base-letter-s" x="276" />
          </g>
          <g class="base-tile">
            <use href="#base-letter-R" x="374" />
            <use href="#base-letter-e" x="462" />
          </g>
          <g class="base-tile">
            <use href="#base-letter-l" x="544" />
            <use href="#base-letter-a" x="578" />
            <use href="#base-letter-y" x="656" />
          </g>
        </g>
      </svg>
    </div>
    <div class="base-legal">
      <span>© {year} Parts Relay</span>
      {versions.length > 0 && (
        <nav class="base-languages" aria-label={f.language}>
          {versions.map((v) => (
            <a
              href={v.href}
              hreflang={v.locale}
              lang={v.locale}
              data-language={v.locale}
              aria-current={v.locale === locale ? 'true' : undefined}
            >
              {name(v.locale)}
            </a>
          ))}
        </nav>
      )}
      <div>
        <a href={localizedPath(locale, '/about/')}>{f.about}</a>
        <span aria-hidden="true">·</span>
        <a href={privacyPolicy} target="_blank" rel="noopener">
          {f.privacy}
        </a>
        <span aria-hidden="true">·</span>
        <a href={cookiePolicy} target="_blank" rel="noopener">
          {f.cookies}
        </a>
      </div>
    </div>
  </div>
</footer>
