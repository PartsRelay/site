---
const { wording } = Astro.props;
---

<ol class="tool-steps">
  {wording.steps.map(([heading, text], index) => (
    <li>
      <span class="tool-stepno" aria-hidden="true">
        {index + 1}
      </span>
      <div>
        <h3>{heading}</h3>
        <p>{text}</p>
      </div>
    </li>
  ))}
</ol>
<blockquote class="tool-example-wording">“{wording.example}”</blockquote>
