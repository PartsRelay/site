---
import { localeOf } from '../i18n/ui';

interface Props {
  wording: {
    steps: string[][];
    example: string;
  };
}

const { wording } = Astro.props;

// Quotation marks follow the page language. French keeps a non-breaking space inside them.
const marks: Record<string, [string, string]> = {
  en: ['“', '”'],
  de: ['„', '“'],
  fr: ['« ', ' »'],
  es: ['«', '»'],
  it: ['«', '»'],
};
const [open, close] = marks[localeOf(Astro.url)] ?? marks.en;
const quoted = open + wording.example + close;
---

<ol class="tool-steps">
  {wording.steps.map(([heading, text], index) => (
    <li>
      <span class="tool-stepno" aria-hidden="true">
        {index + 1}
      </span>
      <div>
        <h3>{heading}</h3>
        <p>{text}</p>
      </div>
    </li>
  ))}
</ol>
<blockquote class="tool-example-wording">{quoted}</blockquote>
