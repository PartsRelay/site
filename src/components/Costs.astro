---
import { assumptions, type Inputs, sliders, sum } from '../costs'
import { measured } from '../facts'
import { translator } from '../i18n'
import Plate from './Plate.astro'
import Section from './Section.astro'

const t = translator(Astro.currentLocale)
const result = sum(
  Object.fromEntries(sliders.map(({ name, value }) => [name, value])) as Inputs,
  Astro.currentLocale!
)
const formula = {
  days: assumptions.days,
  minutes: assumptions.relayMinutes,
  share: assumptions.avoidedShare * 100,
}
const lines = [
  { key: 'hours', unit: ' h' },
  { key: 'time', unit: '' },
  { key: 'avoided', unit: '' },
  { key: 'saved', unit: '' },
] as const
const euros = ['time', 'saved']
const units = { minutes: 'min', returns: '%', hours: 'h' }
---

<Section id="costs">
  <div class="flex max-w-[45rem] flex-col gap-4">
    <h2 class="h2">{t('site.costs.title')}</h2>
    <p class="text-xl text-slate">{t('site.costs.text')}</p>
  </div>

  <Plate caption={t('site.costs.caption')}>
    <div class="flex flex-wrap" data-costs>
      <div class="flex min-w-0 flex-[1_1_25rem] flex-col gap-4 p-8">
        <p class="label mb-1">{t('site.costs.inputs')}</p>
        {
          sliders.map(({ name, letter, min, max, step, value, before, after }) => (
              <div class="flex flex-col">
                <div class="flex items-baseline gap-3">
                  <span aria-hidden="true" class="w-4 flex-none font-mono text-[0.9375rem] text-teal">
                    {letter}
                  </span>
                  <label for={name} class="font-semibold">
                    {t(`site.costs.sliders.${name}`)}
                  </label>
                  <output for={name} class="ml-auto font-mono text-[1.0625rem] whitespace-nowrap">
                    {before + value + after}
                  </output>
                </div>
                <input
                  id={name}
                  name={name}
                  type="range"
                  min={min}
                  max={max}
                  step={step}
                  value={value}
                  data-before={before}
                  data-after={after}
                  class="h-11 w-full accent-teal"
                />
              </div>
          ))
        }
      </div>

      <div
        aria-live="polite"
        class="-mt-px -ml-px flex min-w-0 flex-[1_1_25rem] flex-col border-t border-l border-navy bg-canvas p-8"
      >
        <p class="label mb-2">{t('site.costs.sum')}</p>
        {
          lines.map(({ key, unit }) => (
              <div class="row flex flex-col gap-0.5 py-3.5 last-of-type:border-solid last-of-type:border-navy">
                <div class="flex items-baseline justify-between gap-4">
                  <span>{t(`site.costs.lines.${key}.label`)}</span>
                  <span class="font-mono text-[1.1875rem] whitespace-nowrap">
                    {euros.includes(key) && '€ '}
                    <span data-out={key}>{result[key]}</span>
                    {unit}
                  </span>
                </div>
                <span class="font-mono text-[0.8125rem] text-slate">
                  {t(`site.costs.lines.${key}.formula`, formula)}
                </span>
              </div>
          ))
        }
        <p class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 pt-5">
          <span class="font-heading text-xl font-bold">{t('site.costs.month')}</span>
          <span
            class="font-heading text-[clamp(2.4rem,4.4vw,3.4rem)] leading-none font-extrabold tracking-[-0.03em] whitespace-nowrap text-teal"
          >
            € <span data-out="month">{result.month}</span>
          </span>
        </p>
        <p class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 pt-1.5">
          <span class="text-slate">{t('site.costs.year')}</span>
          <span class="font-mono text-[1.1875rem] whitespace-nowrap">
            € <span data-out="year">{result.year}</span>
          </span>
        </p>
      </div>
    </div>
  </Plate>

  <div class="flex flex-col gap-2">
    <p class="label">{t('site.costs.measured.title', { source: measured.source })}</p>
    <div class="flex flex-wrap gap-x-14 border-t border-dotted border-rule">
      {
        Object.entries(units).map(([key, unit]) => (
          <div class="row flex min-w-0 flex-[1_1_15rem] flex-col gap-1.5 py-6">
            <p class="font-heading text-[clamp(2.1rem,3.8vw,3rem)] leading-none font-extrabold tracking-[-0.03em]">
              {measured[key as keyof typeof units]} {unit}
            </p>
            <p class="text-slate">{t(`site.costs.measured.${key}`)}</p>
          </div>
        ))
      }
    </div>
  </div>
</Section>

<script>
  import { type Inputs, sum } from '../costs'

  const figure = document.querySelector<HTMLElement>('[data-costs]')!
  const inputs = [...figure.querySelectorAll('input')]

  figure.addEventListener('input', () => {
    const values = Object.fromEntries(inputs.map((input) => [input.name, input.valueAsNumber]))

    for (const input of inputs) {
      const { before = '', after = '' } = input.dataset

      figure.querySelector<HTMLOutputElement>(`output[for="${input.id}"]`)!.value =
        before + input.value + after
    }
    for (const [key, value] of Object.entries(sum(values as Inputs, document.documentElement.lang))) {
      figure.querySelector(`[data-out="${key}"]`)!.textContent = value
    }
  })
</script>
