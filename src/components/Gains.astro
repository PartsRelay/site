---
import { translator } from '../i18n'
import Section from './Section.astro'

const t = translator(Astro.currentLocale)
const icons = {
  replies: '<path d="M5 7h22v15H13l-6 5v-5H5z"/><path class="stroke-teal" d="M11 13h10M11 17h6"/>',
  vehicle:
    '<path d="M4 20v-5l3-7h18l3 7v5z"/><path d="M4 15h24"/><circle class="stroke-teal" cx="9.5" cy="21.5" r="2.5"/><circle class="stroke-teal" cx="22.5" cy="21.5" r="2.5"/>',
  queue:
    '<rect x="5" y="5" width="22" height="22" rx="2"/><path class="stroke-teal" d="M10 11h12M10 16h12M10 21h7"/>',
  install:
    '<rect x="10" y="3" width="12" height="26" rx="3"/><path d="M14 24h4"/><path class="stroke-teal" d="M13.5 13.5l2 2 3.5-4"/>',
}
---

<Section id="gain">
  <h2 class="h2 max-w-[20em]">{t('site.gain.title')}</h2>
  <div class="flex flex-wrap gap-x-14 border-t border-dotted border-rule">
    {
      Object.entries(icons).map(([item, icon]) => (
        <article class="row flex min-w-0 flex-[1_1_25rem] gap-5 py-7">
          <svg
            viewBox="0 0 32 32"
            width="36"
            height="36"
            aria-hidden="true"
            class="mt-0.5 flex-none fill-none stroke-navy"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
            set:html={icon}
          />
          <div class="flex flex-col gap-1.5">
            <h3 class="h3">{t(`site.gain.items.${item}.title`)}</h3>
            <p class="text-slate">{t(`site.gain.items.${item}.text`)}</p>
          </div>
        </article>
      ))
    }
  </div>
</Section>
