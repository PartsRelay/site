---
import Layout from './Layout.astro';
import { localeOf, localizedPath, ui } from '../i18n/ui';

interface Props {
  title: string;
  description: string;
  heading: string;
  audience: string;
  poster: string;
  posterAlt: string;
  prepare: { term: string; text: string }[];
}

const { title, description, heading, audience, poster, posterAlt, prepare } = Astro.props;
const locale = localeOf(Astro.url) as keyof typeof ui;
const t = ui[locale].workshop;
const allWorkshops = localizedPath(locale, '/workshops/');
---

<Layout title={title} description={description}>
  <article class="workshop workshop-lesson">
    <div class="workshop-lesson-grid">
      <aside class="workshop-session-info">
        <div class="workshop-poster">
          <div class="workshop-poster-top">
            <img src="/assets/symbol-white.svg" alt="" />
            <span>Parts Relay</span>
          </div>
          <span class="workshop-poster-title">{t.poster}</span>
          <img class="workshop-poster-art" src={poster} alt={posterAlt} />
        </div>
        <dl class="workshop-prep">
          {prepare.map((item) => (
            <div>
              <dt>{item.term}</dt>
              <dd>{item.text}</dd>
            </div>
          ))}
        </dl>
      </aside>
      <div class="workshop-story">
        <a class="workshop-breadcrumb" href={allWorkshops}>
          ← {t.back}
        </a>
        <h1 tabindex="-1">{heading}</h1>
        <p class="workshop-meta">{audience}</p>
        <p class="workshop-intro">
          <slot name="intro" />
        </p>
        <slot />
        <a class="workshop-breadcrumb" href={allWorkshops}>
          ← {t.back}
        </a>
      </div>
    </div>
  </article>
</Layout>
