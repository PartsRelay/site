---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { contactEmail, productSummary } from '../site';
import '../styles/base.css';
import '../styles/header.css';
import '../styles/home.css';
import '../styles/pages.css';
import '../styles/tools.css';
import '../styles/teams.css';
import '../styles/library.css';
import '../styles/brand.css';
import '../styles/workshops.css';
import '../styles/header-motion.css';

interface Props {
  title: string;
  description: string;
  home?: boolean;
  structuredData?: boolean;
  noindex?: boolean;
}

const { title, description, home = false, structuredData = false, noindex = false } = Astro.props;

const origin = Astro.site?.href;
const canonical = origin ? new URL(Astro.url.pathname, origin).href : Astro.url.pathname;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': '#organization',
      name: 'Parts Relay',
      email: contactEmail,
      ...(origin ? { url: origin, logo: origin + 'assets/logo.svg' } : {}),
    },
    {
      '@type': 'SoftwareApplication',
      '@id': '#software',
      name: 'Parts Relay',
      applicationCategory: 'BusinessApplication',
      operatingSystem: 'Web',
      description: productSummary,
      audience: {
        '@type': 'BusinessAudience',
        audienceType: 'Parts distributors and vehicle repair shops',
      },
      publisher: { '@id': '#organization' },
      ...(origin ? { url: origin } : {}),
    },
  ],
};
---

<!doctype html>
<html lang="en" class={home ? undefined : 'page-interior'}>
  <head>
    <!-- The iubenda embed has to be the first tag in the head. -->
    <script
      is:inline
      type="text/javascript"
      src="https://embeds.iubenda.com/widgets/bbd2e5dc-7500-437f-b3bc-e4a06b580c61.js"
    ></script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="theme-color" content="#087781" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Parts Relay" />
    {origin && !noindex && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary" />
    <link rel="icon" type="image/svg+xml" href="/assets/symbol.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon-32.png" />
    {structuredData && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
  </head>
  <body>
    <a class="skip-main" href="#main">
      Skip to content
    </a>
    <Header />
    <main id="main" tabindex="-1">
      {home ? (
        <slot />
      ) : (
        <div class="page-detail">
          <slot />
        </div>
      )}
    </main>
    <Footer />
    <script>
      import '../scripts/header.js';
      import '../scripts/header-motion.js';
      import '../scripts/page.js';
    </script>
  </body>
</html>
