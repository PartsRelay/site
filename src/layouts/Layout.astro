---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import AskAi from '../components/AskAi.astro';
import { contactEmail, productSummary } from '../site';
import { alternates, splitLocale, ui } from '../i18n/ui';
import '../styles/base.css';
import '../styles/header.css';
import '../styles/home.css';
import '../styles/pages.css';
import '../styles/tools.css';
import '../styles/teams.css';
import '../styles/library.css';
import '../styles/brand.css';
import '../styles/pricing.css';
import '../styles/header-motion.css';

interface Props {
  title: string;
  description: string;
  home?: boolean;
  structuredData?: boolean;
  noindex?: boolean;
}

const { title, description, home = false, structuredData = false, noindex = false } = Astro.props;

const origin = Astro.site?.href;
const canonical = origin ? new URL(Astro.url.pathname, origin).href : Astro.url.pathname;

type Locale = keyof typeof ui;
const split = splitLocale(Astro.url.pathname);
const locale = split.locale as Locale;
const path: string = split.path;
const t = ui[locale];
const versions = alternates(path);
const toUrl = (href: string) => (origin ? new URL(href, origin).href : href);
// Share previews need a full address for the image. Until SITE_ORIGIN is set, use the
// production address Vercel provides during its build.
const vercelHost = process.env.VERCEL_PROJECT_PRODUCTION_URL;
const imageOrigin = origin ?? (vercelHost ? `https://${vercelHost}/` : undefined);
const shareImage = imageOrigin
  ? new URL('/assets/share.png', imageOrigin).href
  : '/assets/share.png';
const shareAlt = 'Parts Relay: find the right part for the car in your bay.';
// What the language bar needs: where each version lives, and its offer in that language.
const languageData = versions.length
  ? JSON.stringify({
      current: locale,
      versions: Object.fromEntries(versions.map((v) => [v.locale, v.href])),
      offers: Object.fromEntries(versions.map((v) => [v.locale, ui[v.locale as Locale].suggest])),
    })
  : null;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': '#organization',
      name: 'Parts Relay',
      email: contactEmail,
      ...(origin ? { url: origin, logo: origin + 'assets/logo.svg' } : {}),
    },
    {
      '@type': 'SoftwareApplication',
      '@id': '#software',
      name: 'Parts Relay',
      applicationCategory: 'BusinessApplication',
      operatingSystem: 'Web',
      description: productSummary,
      audience: {
        '@type': 'BusinessAudience',
        audienceType: 'Parts distributors and vehicle repair shops',
      },
      publisher: { '@id': '#organization' },
      ...(origin ? { url: origin } : {}),
    },
  ],
};
---

<!doctype html>
<html lang={locale} class={home ? undefined : 'page-interior'}>
  <head>
    <!--
      The iubenda embed has to be the first tag in the head, after its own settings.
      By default iubenda saves consent on the parent of the current host (www.example.com
      becomes example.com). On hosts like example.co.uk or a *.pages.dev preview that parent
      is a public suffix, the browser rejects the cookie, and the banner returns on every
      page. Saving consent on the exact host the page is served from avoids that.
    -->
    <script is:inline>
      window._iub = window._iub || [];
      _iub.csConfiguration = { localConsentDomain: location.hostname };
    </script>
    <script
      is:inline
      type="text/javascript"
      src="https://embeds.iubenda.com/widgets/bbd2e5dc-7500-437f-b3bc-e4a06b580c61.js"
    ></script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="theme-color" content="#087781" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Parts Relay" />
    {origin && !noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={shareAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={shareImage} />
    <meta name="twitter:image:alt" content={shareAlt} />
    <link rel="icon" type="image/svg+xml" href="/assets/symbol.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon-32.png" />
    {!noindex &&
      versions.map((v) => <link rel="alternate" hreflang={v.locale} href={toUrl(v.href)} />)}
    {!noindex && versions.length > 0 && (
      <link rel="alternate" hreflang="x-default" href={toUrl(path)} />
    )}
    {structuredData && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
  </head>
  <body>
    <a class="skip-main" href="#main">
      {t.skip}
    </a>
    {languageData && <script type="application/json" id="language-data" set:html={languageData} />}
    <Header locale={locale} />
    <main id="main" tabindex="-1">
      {home ? (
        <slot />
      ) : (
        <div class="page-detail">
          <slot />
        </div>
      )}
    </main>
    <AskAi locale={locale} />
    <Footer locale={locale} versions={versions} />
    <script>
      import '../scripts/header.js';
      import '../scripts/header-motion.js';
      import '../scripts/page.js';
      import '../scripts/language.js';
      import '../scripts/ask-ai.js';
    </script>
  </body>
</html>
