{
  "$schema": "https://raw.githubusercontent.com/devcontainers/spec/main/schemas/devContainer.schema.json",
  "name": "PartsRelay Site",
  "dockerComposeFile": ["../docker-compose.yml"],
  "service": "app",
  "workspaceFolder": "/workspace",
  "shutdownAction": "stopCompose",
  "overrideCommand": false,
  "initializeCommand": "test -f .env || cp .env.example .env",
  "remoteUser": "node",
  "updateRemoteUserUID": true,

  "features": {
    "ghcr.io/devcontainers-extra/features/bun:1": { "version": "latest" },
    "ghcr.io/devcontainers-extra/features/cloudflared:1": {}
  },

  "portsAttributes": {
    "4321": { "label": "Site", "onAutoForward": "ignore" }
  },

  "remoteEnv": {
    "PATH": "${containerWorkspaceFolder}/node_modules/.bin:${containerEnv:PATH}"
  },

  "onCreateCommand": "bash .devcontainer/on-create.sh",
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "postStartCommand": "bash .devcontainer/post-start.sh",
  "postAttachCommand": "bash .devcontainer/post-attach.sh",
  "waitFor": "postCreateCommand",

  "customizations": {
    "vscode": {
      "extensions": [
        "oven.bun-vscode",
        "astro-build.astro-vscode",
        "EditorConfig.EditorConfig",
        "mikestead.dotenv"
      ],
      "settings": {
        "files.watcherExclude": { "**/node_modules/**": true, "**/dist/**": true }
      }
    }
  }
}
