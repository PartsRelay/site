{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    {
      "src": "^/_astro/(.*)$",
      "headers": { "cache-control": "public, max-age=31536000, immutable" },
      "continue": true
    },
    { "handle": "filesystem" },
    {
      "src": "^/_astro/(.*)$",
      "status": 404,
      "headers": { "cache-control": "no-store" }
    }
  ]
}
